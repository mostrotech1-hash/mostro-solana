{
   "name": "@mostro/shared",
   "version": "0.1.0",
   "private": true,
   "description": "TypeScript SDK for the Mostro Solana program: PDAs, curve math, price helpers, instruction builders and typed account fetchers",
   "type": "commonjs",
   "main": "./src/index.ts",
   "types": "./src/index.ts",
   "exports": {
      ".": "./src/index.ts",
      "./idl": "./idl/mostro.json",
      "./types": "./types/mostro.ts",
      "./addresses/devnet": "./addresses/devnet.json",
      "./api": "./src/api/index.ts"
   },
   "files": [
      "src",
      "idl",
      "types",
      "addresses",
      "README.md"
   ],
   "scripts": {
      "typecheck": "tsc --noEmit -p tsconfig.json",
      "test": "NODE_OPTIONS=--no-experimental-strip-types ts-mocha -p ../tsconfig.json \"test/**/*.test.ts\""
   },
   "dependencies": {
      "@coral-xyz/anchor": "0.32.1",
      "@metaplex-foundation/mpl-core": "^1.10.0",
      "@metaplex-foundation/umi": "^1.6.0",
      "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
      "@solana/spl-token": "^0.4.13",
      "@solana/web3.js": "^1.98.0",
      "bn.js": "^5.2.1"
   },
   "devDependencies": {
      "@types/bn.js": "^5.1.6",
      "@types/chai": "^4.3.0",
      "@types/mocha": "^10.0.9",
      "@types/node": "^22.0.0",
      "chai": "^4.5.0",
      "mocha": "^10.8.2",
      "ts-mocha": "^10.0.0",
      "typescript": "^5.6.0"
   }
}
