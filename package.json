{
   "name": "mostro-solana",
   "private": true,
   "engines": {
      "node": ">=24"
   },
   "workspaces": [
      "shared",
      "back",
      "fronts/*"
   ],
   "scripts": {
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "build:programs": "anchor build",
      "test:programs": "anchor test --skip-local-validator --provider.cluster localnet",
      "test:unit": "cargo test -p mostro --lib",
      "seed:devnet": "ts-node scripts/seed-devnet.ts",
      "export:shared": "bash scripts/export-shared.sh",
      "dev:fronts": "node scripts/dev-fronts.mjs",
      "dev:back": "yarn workspace @mostro/back dev",
      "db:up": "docker compose -f docker-local/docker-compose.yml up -d --wait db",
      "db:migrate": "docker compose -f docker-local/docker-compose.yml run --rm flyway-init && docker compose -f docker-local/docker-compose.yml run --rm flyway-app",
      "db:down": "docker compose -f docker-local/docker-compose.yml down",
      "typecheck": "yarn workspace @mostro/back typecheck && yarn workspace @app/front-nuxt typecheck"
   },
   "devDependencies": {
      "prettier": "^3.8.4",
      "@coral-xyz/anchor": "0.32.1",
      "@solana/web3.js": "^1.98.0",
      "@solana/spl-token": "^0.4.13",
      "@metaplex-foundation/mpl-core": "^1.10.0",
      "@metaplex-foundation/umi": "^1.6.0",
      "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
      "bn.js": "^5.2.1",
      "chai": "^4.5.0",
      "mocha": "^10.8.2",
      "ts-mocha": "^10.0.0",
      "ts-node": "^10.9.2",
      "typescript": "^5.6.0",
      "@types/bn.js": "^5.1.6",
      "@types/chai": "^4.3.0",
      "@types/mocha": "^10.0.9",
      "@types/node": "^22.0.0"
   }
}
