{
   "name": "@mostro/back",
   "version": "1.0.0",
   "private": true,
   "description": "Minimal Mostro API: users table, avatars, MoonPay URL signing, Openfort wallet recovery session.",
   "scripts": {
      "dev": "tsx watch src/main.ts",
      "start": "tsx src/main.ts",
      "typecheck": "tsc --noEmit -p tsconfig.json",
      "test": "tsx --test test/*.test.ts",
      "e2e:devnet": "tsx scripts/e2e-devnet.ts",
      "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/vercel.js --external:pg-native --external:@nestjs/microservices --external:@nestjs/websockets --external:class-validator --external:class-transformer --external:@nestjs/microservices/microservices-module --external:@nestjs/websockets/socket-module --external:cache-manager --alias:@mostro/shared/api=../shared/src/api/index.ts",
      "db:migrate:remote": "tsx scripts/migrate.ts",
      "deploy:vercel": "node scripts/deploy-vercel.mjs"
   },
   "dependencies": {
      "@coral-xyz/anchor": "0.32.1",
      "@mostro/shared": "0.1.0",
      "@nestjs/common": "^11.1.27",
      "@nestjs/core": "^11.1.27",
      "@nestjs/platform-express": "^11.1.27",
      "@openfort/openfort-node": "^0.13.1",
      "@solana/web3.js": "^1.98.0",
      "dotenv": "^17.4.2",
      "pg": "^8.21.0",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.2",
      "zod": "^4.4.3",
      "@vercel/blob": "^2.0.0"
   },
   "devDependencies": {
      "@types/express": "^5.0.6",
      "@types/multer": "^1.4.13",
      "@types/node": "^22.19.7",
      "@types/pg": "^8.15.0",
      "tsx": "^4.20.0",
      "typescript": "~5.9.3",
      "esbuild": "^0.28.2"
   }
}
