# --- Server ---
PORT=3100
# Trusted reverse proxy IPs/CIDRs, comma separated. Empty ignores forwarded headers.
# Configure only proxies that overwrite client-supplied forwarding headers.
TRUSTED_PROXIES=
# Origin of the front (CORS). front-nuxt runs on 4200.
FRONTEND_ORIGIN=http://localhost:4200
# Public URL of this API. Avatar links returned to the front are built from it.
PUBLIC_API_URL=http://localhost:3100

# --- Database (docker-local/docker-compose.yml + `yarn db:up` + `yarn db:migrate`) ---
DATABASE_URL=postgresql://app_user:app_user_password@localhost:45434/mostro_db

# --- Openfort (https://dashboard.openfort.io) ---
# Publishable key (pk_...) of the SAME project as the front. Secret key (sk_...) is server-only.
OPENFORT_PUBLISHABLE_KEY=
OPENFORT_SECRET_KEY=
# Shield, for automatic wallet recovery (Developers > Shield). All three are server-only.
SHIELD_API_KEY=
SHIELD_API_SECRET=
SHIELD_ENCRYPTION_SHARE=

# --- MoonPay (https://dashboard.moonpay.com/developers) ---
# The key prefix (pk_test / pk_live) picks the environment. The secret key signs the widget URL: server-only.
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
# Exact buy-widget origin accepted by the signer. Use https://buy.moonpay.com with pk_live keys.
MOONPAY_WIDGET_BASE_URL=https://buy-sandbox.moonpay.com
# Fiat currency the user pays with (card).
MOONPAY_BASE_CURRENCY=usd
# Local development only: YOUR public IP (open https://api.ipify.org). MoonPay checks the buyer IP and this API only sees localhost.
# Leave empty in production, where the API sees the real buyer IP.
MOONPAY_DEV_CLIENT_IP=

# --- Sponsor wallet (pays the fees of user transactions as `payer`) ---
# A dedicated Solana keypair (NOT the admin key), as a JSON array of numbers. Server-only: never put it in the front.
# Create one with: node -e "const {Keypair}=require('@solana/web3.js');console.log('['+Array.from(Keypair.generate().secretKey)+']')"
# Fund its public address with devnet SOL (it pays the fee and the rent of every pass purchase, about 0.007 SOL each).
# The API refuses to build purchases when its balance drops under 0.02 SOL.
SPONSOR_SECRET_KEY=

# --- Solana devnet (the demo pass: 1,200 $MOST, bought and redeemed in one sponsored transaction) ---
# Only devnet is supported; the API refuses to start a purchase against any other cluster.
SOLANA_CLUSTER=devnet
# A provider URL with a key works too (keep it server-side). The public one is rate limited.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet only: MoonPay cannot deliver devnet SOL, so after the card step the API sends DEVNET_TOPUP_LAMPORTS from the sponsor wallet
# to a wallet that is still short of SOL
# (it keeps a 0.05 SOL reserve). 150000000 = 0.15 SOL = the minimum MoonPay sells. Set ENABLED to false to turn it off.
DEVNET_TOPUP_ENABLED=true
DEVNET_TOPUP_LAMPORTS=150000000
# Set to true to allow only one pass per wallet.
ENFORCE_ONE_PASS_PER_WALLET=false

# --- Avatars ---
# Where uploaded avatars are stored: <AVATARS_DIR>/<userId>/<file>. Git-ignored. Defaults to back/storage/avatars.
# AVATARS_DIR=
