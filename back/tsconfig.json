{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": false,
      "noEmit": true,
      "resolveJsonModule": true,
      "types": ["node", "multer"],
      "paths": {
         "@mostro/shared/api": ["../shared/src/api/index.ts"]
      }
   },
   "include": ["src/**/*"]
}
