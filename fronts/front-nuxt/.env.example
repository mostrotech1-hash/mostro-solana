# Openfort publishable key (pk_test_... / pk_live_...). Safe for the browser.
# Dashboard > Developers > API keys. NEVER use the secret key (sk_...) here: it goes in back/.env.
NUXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=

# Shield publishable key. Required for the non-custodial embedded wallet.
# Dashboard > Developers > Shield (the publishable key of your Shield project).
NUXT_PUBLIC_SHIELD_PUBLISHABLE_KEY=

# Mostro API (back/). Must match PORT in back/.env.
NUXT_PUBLIC_API_BASE=http://localhost:3100

# Solana cluster for explorer links: devnet | testnet | mainnet-beta
NUXT_PUBLIC_SOLANA_CLUSTER=devnet

# Solana devnet RPC the browser uses to send and confirm the pass purchase (public RPC; a provider URL with a key works too).
NUXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
